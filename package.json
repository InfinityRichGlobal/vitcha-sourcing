{
  "name": "vitcha-china-sourcing",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "typecheck": "tsc --noEmit",
    "backup:live": "node scripts/backup-live.mjs",
    "postbuild": "node scripts/finalize-build.mjs",
    "release": "npm run build && node scripts/package-release.mjs",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-leaflet": "^0.1.4",
    "@types/leaflet": "^1.9.16",
    "@types/node": "^22.13.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.16.0",
    "maplibre-gl": "^6.16.0",
    "postcss": "^8.5.1",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@playwright/test": "^1.64.1"
  }
